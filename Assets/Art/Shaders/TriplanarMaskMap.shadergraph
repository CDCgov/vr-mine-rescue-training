    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "TriplanarMaskMap",
    "m_FunctionSource": "fd3c3ca74db9c194cbbd0c00bf1c33ef",
    "m_FunctionBody": "void MultitextureTriplanar_float(Texture2D TextureA, Texture2D TextureB, Texture2D TextureC, SamplerState Sampler,\r\n        float3 Position, float3 Normal, float Tile, float Blend, out float4 Out){\r\n    float3 Node_UV = Position * Tile;\r\n    float3 Node_Blend = pow(abs(Normal), Blend);\r\n    Node_Blend /= dot(Node_Blend, 1.0);\r\n    float4 Node_X = SAMPLE_TEXTURE2D(TextureA, Sampler, Node_UV.zy);\r\n    float4 Node_Y = SAMPLE_TEXTURE2D(TextureB, Sampler, Node_UV.xz);\r\n    float4 Node_Z = SAMPLE_TEXTURE2D(TextureC, Sampler, Node_UV.xy);\r\n    Out = Node_X * Node_Blend.x + Node_Y * Node_Blend.y + Node_Z * Node_Blend.z;\r\n}"
}

