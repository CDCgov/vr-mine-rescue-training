<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Art/Sprites/gray-square.svg?fileID=7388822144124034973&amp;guid=089bcdd2564886c45aa56493753ce475&amp;type=3#gray-square&quot;); -unity-background-image-tint-color: rgb(152, 152, 152); background-color: rgb(89, 89, 89); background-size: 100% 100%; -unity-slice-left: 15; -unity-slice-top: 15; -unity-slice-right: 15; -unity-slice-bottom: 15; margin-top: 6px; margin-right: 6px; margin-bottom: 6px; margin-left: 6px; padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px;">
        <ui:ProgressBar value="0.6" title="my-progress" high-value="1">
            <Bindings>
                <ui:DataBinding property="title" data-source-path="LoadMessage" binding-mode="ToTarget" data-source-type="ExternalAssetsEditorDS, VRMineCore"/>
                <ui:DataBinding property="value" data-source-path="LoadProgress" binding-mode="ToTarget" data-source-type="ExternalAssetsEditorDS, VRMineCore" update-trigger="EveryUpdate"/>
            </Bindings>
        </ui:ProgressBar>
        <ui:Label text="Test" name="TestLabel">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="TestValue" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <ui:Label text="Label" name="LoadMessage">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="LoadMessage" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <ui:Label text="Label" name="LoadProgress">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="LoadProgress" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <ui:Button text="Button"/>
        <ui:ListView name="LoadableList" item-template="project://database/Assets/Prefabs/UIToolkit/LoadableAssetDetails.uxml?fileID=9197481963319205126&amp;guid=1272eab590349e64ba2a6b85588eb279&amp;type=3#LoadableAssetDetails" binding-source-selection-mode="AutoAssign" fixed-item-height="150" virtualization-method="DynamicHeight" show-border="true" reorderable="true"/>
    </ui:VisualElement>
</ui:UXML>
