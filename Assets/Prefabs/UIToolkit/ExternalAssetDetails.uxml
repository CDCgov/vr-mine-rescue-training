<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/DefaultUSS.uss?fileID=7433441132597879392&amp;guid=428b4e6fb25c6294c9f0a8ddbb7d203b&amp;type=3#DefaultUSS"/>
    <ui:VisualElement name="AssetDetailsPanel" style="flex-grow: 1;">
        <ui:ScrollView name="ScrollView" vertical-scroller-visibility="AlwaysVisible" class="container__vertical-scroll">
            <ui:Label text="Filename" class="label__panel-title">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="SelectedAsset.MetadataFilename" data-source-type="UIExternalAssetDetails, VRMineCore" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
            <ui:VisualElement name="AssetInfo">
                <LabeledTextField label-text="Asset ID" name="AssetID">
                    <Bindings>
                        <ui:DataBinding property="Text" data-source-path="SelectedAsset.LoadableAsset.AssetID" binding-mode="ToTarget"/>
                    </Bindings>
                </LabeledTextField>
                <LabeledTextField label-text="Asset Name" name="AssetName">
                    <Bindings>
                        <ui:DataBinding property="Text" data-source-path="SelectedAsset.LoadableAsset.AssetWindowName" data-source-type="UIExternalAssetDetails, VRMineCore" binding-mode="ToTarget"/>
                    </Bindings>
                </LabeledTextField>
                <LabeledTextField label-text="Category" name="AssetCategory">
                    <Bindings>
                        <ui:DataBinding property="Text" data-source-path="SelectedAsset.AssetCategory" data-source-type="ExternalAssetDS, VRMineCore" binding-mode="ToTarget"/>
                    </Bindings>
                </LabeledTextField>
            </ui:VisualElement>
            <ui:VisualElement name="AssetEditors" style="flex-grow: 1;"/>
            <ui:GroupBox name="ImportLogBox" text="Import Log Messages">
                <ui:Label text="Label" name="ImportLogText" class="monospace-text large-text-box">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="SelectedAsset.ImportLogText" data-source-type="UIExternalAssetDetails, VRMineCore" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <Bindings>
                    <ui:DataBinding property="style.display" data-source-path="SelectedAsset.ShowImportLogs" data-source-type="UIExternalAssetDetails, VRMineCore" binding-mode="ToTarget"/>
                </Bindings>
            </ui:GroupBox>
            <ui:GroupBox text="Asset Details" name="AssetDetailBox">
                <ui:Label text="Label" name="AssetDetails" class="large-text-box monospace-text">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="SelectedAsset.AssetDetailText" data-source-type="UIExternalAssetDetails, VRMineCore" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
            </ui:GroupBox>
        </ui:ScrollView>
        <ui:VisualElement name="AssetButtons" class="container__horizontal-buttons">
            <ui:Button text="Button"/>
            <ui:Button text="Button"/>
            <ui:Button text="Button"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="DefaultDisplay" class="window-overlay" style="display: none;">
        <ui:Label text="Select an asset to view details"/>
        <Bindings>
            <ui:DataBinding property="style.display" data-source-path="ShowDefaultScreen" data-source-type="UIExternalAssetDetails, VRMineCore" binding-mode="ToTarget"/>
        </Bindings>
    </ui:VisualElement>
</ui:UXML>
